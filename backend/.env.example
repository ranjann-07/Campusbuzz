# Server Configuration
NODE_ENV=production
PORT=5001
JWT_SECRET=replace_with_a_long_random_production_secret

# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/campusbuzz_db?retryWrites=true&w=majority
MONGODB_DB_NAME=campusbuzz_db

# CORS Configuration (comma-separated frontend URLs)
FRONTEND_URL=https://your-vercel-app.vercel.app
CORS_ORIGIN=https://your-vercel-app.vercel.app,http://localhost:3000
ALLOW_VERCEL_PREVIEWS=true
